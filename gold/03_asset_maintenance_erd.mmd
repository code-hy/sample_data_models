        string maintenance_regime
    }
    DIM_ASSET {
        bigint asset_sk PK
        string asset_tag UK
        bigint asset_class_fk FK
        string manufacturer
        date in_service_date
        string current_operator_fk
        string owning_entity
        string asset_status
    }
    DIM_COMPONENT {
        bigint component_sk PK
        string component_code UK
        string component_name
        bigint asset_class_fk FK
        string criticality
        boolean smart_sensor_flag
    }
