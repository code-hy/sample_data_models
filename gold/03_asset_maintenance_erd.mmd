        bigint bridge_id PK
        bigint asset_fk FK
        bigint component_fk FK
        date fitted_date
        date removed_date
        decimal accumulated_usage_km
    }
    DIM_PROJECT {
        bigint project_sk PK
        string project_code UK
        string project_name
        string project_type
        string program
        string status
    }
