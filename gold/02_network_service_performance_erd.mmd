        bigint vehicle_asset_fk
        timestamp scheduled_start_datetime
        timestamp actual_start_datetime
        boolean on_time_flag
        int late_minutes
        boolean cancelled_flag
    }
    FACT_STOP_DWELL {
        bigint dwell_id PK
        bigint service_run_fk FK
        bigint location_sk FK
        int stop_sequence
        timestamp scheduled_departure
        timestamp actual_departure
